<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app_image" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA05070D" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingTop="14dp"
        android:paddingRight="28dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:background="@drawable/tv_card_bg"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="14dp"
            android:paddingRight="16dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/txtBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/brand_name"
                android:textColor="#E50914"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="10dp"
                android:text="Ingresá tu correo para continuar"
                android:textColor="#9CA3AF"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Correo electrónico"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/tv_input_selector"
                android:defaultFocusHighlightEnabled="false"
                android:hint="usuario@correo.com"
                android:inputType="textEmailAddress"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:singleLine="true"
                android:stateListAnimator="@null"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text=""
                android:textAlignment="center"
                android:textColor="#F87171"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/tv_button_selector"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:foreground="@null"
                android:gravity="center"
                android:outlineProvider="none"
                android:stateListAnimator="@null"
                android:text="Continuar"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>