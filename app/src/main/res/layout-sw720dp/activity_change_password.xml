<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_app_image">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="80dp"
        android:paddingRight="80dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/txtChangeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nueva contraseña"
                android:textColor="#E50914"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

            <TextView
                android:id="@+id/txtChangeSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Actualizá tu acceso para continuar"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#141922"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu contraseña fue restablecida. Debés crear una nueva para continuar."
                android:textColor="#D1D5DB"
                android:textSize="11sp"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/edtNewPassword"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/tv_input_selector"
                android:hint="Nueva contraseña"
                android:inputType="textPassword"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="12sp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/edtConfirmPassword" />

            <EditText
                android:id="@+id/edtConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/tv_input_selector"
                android:hint="Confirmar contraseña"
                android:inputType="textPassword"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="12sp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/edtNewPassword"
                android:nextFocusDown="@id/btnSavePassword" />

            <TextView
                android:id="@+id/txtPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text=""
                android:textColor="#F87171"
                android:textSize="10sp"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_gravity="center"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSavePassword"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/tv_button_selector"
                android:text="Guardar nueva contraseña"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/edtConfirmPassword" />

            <ProgressBar
                android:id="@+id/progressChangePassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>