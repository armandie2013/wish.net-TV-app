<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app_image" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA05070D" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="60dp"
        android:paddingTop="24dp"
        android:paddingRight="60dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:background="@drawable/tv_card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="wish.net TV"
                android:textColor="#E50914"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="Confirmá tu nueva contraseña"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Confirmar contraseña"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/tv_input_selector"
                android:defaultFocusHighlightEnabled="false"
                android:hint="Confirmar contraseña"
                android:inputType="textPassword"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:stateListAnimator="@null"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text=""
                android:textAlignment="center"
                android:textColor="#F87171"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnSavePassword"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/tv_button_selector"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:foreground="@null"
                android:gravity="center"
                android:outlineProvider="none"
                android:stateListAnimator="@null"
                android:text="Guardar contraseña"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBackPassword"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/tv_button_secondary_selector"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:foreground="@null"
                android:gravity="center"
                android:outlineProvider="none"
                android:stateListAnimator="@null"
                android:text="Volver"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/progressChangePassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>